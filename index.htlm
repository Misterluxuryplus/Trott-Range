<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Calculateur autonomie</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #111;
      color: white;
      margin: 0;
      padding: 20px;
      text-align: center;
    }

    .container {
      max-width: 700px;
      margin: auto;
    }

    h1 {
      color: #00e676;
      margin-bottom: 25px;
    }

    .field {
      margin-bottom: 18px;
    }

    label {
      display: block;
      font-weight: bold;
      margin-bottom: 6px;
    }

    input, select {
      width: 260px;
      padding: 12px;
      font-size: 16px;
      border-radius: 8px;
      border: none;
    }

    button {
      margin-top: 10px;
      padding: 14px 24px;
      font-size: 18px;
      font-weight: bold;
      border: none;
      border-radius: 8px;
      background: #00e676;
      color: black;
      cursor: pointer;
    }

    .result {
      margin-top: 25px;
      background: #1c1c1c;
      padding: 16px;
      border-radius: 12px;
      line-height: 1.8;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Calculateur autonomie</h1>

    <div class="field">
      <label for="battery">Batterie (%)</label>
      <input type="number" id="battery" value="100" min="0" max="100">
    </div>

    <div class="field">
      <label for="weight">Poids (kg)</label>
      <input type="number" id="weight" value="107" min="1">
    </div>

    <div class="field">
      <label for="volts">Volts</label>
      <select id="volts">
        <option value="36">36</option>
        <option value="48">48</option>
        <option value="52">52</option>
        <option value="60" selected>60</option>
        <option value="72">72</option>
      </select>
    </div>

    <div class="field">
      <label for="ah">Ampérage (Ah)</label>
      <select id="ah">
        <option value="20">20</option>
        <option value="24">24</option>
        <option value="30">30</option>
        <option value="35" selected>35</option>
        <option value="40">40</option>
      </select>
    </div>

    <div class="field">
      <label for="distance">Distance aller (km)</label>
      <input type="number" id="distance" value="10" min="0" step="0.1">
    </div>

    <button onclick="calculer()">Calculer</button>

    <div class="result" id="result">
      Clique sur Calculer.
    </div>
  </div>

  <script>
    function calculer() {
      let battery = parseFloat(document.getElementById("battery").value);
      let weight = parseFloat(document.getElementById("weight").value);
      let volts = parseFloat(document.getElementById("volts").value);
      let ah = parseFloat(document.getElementById("ah").value);
      let distance = parseFloat(document.getElementById("distance").value);

      if (isNaN(battery) || isNaN(weight) || isNaN(volts) || isNaN(ah) || isNaN(distance)) {
        document.getElementById("result").innerHTML = "Merci de remplir tous les champs.";
        return;
      }

      if (battery > 100) battery = 100;
      if (battery < 0) battery = 0;

      let wh = volts * ah;
      let disponible = wh * (battery / 100);

      let consommation = 30;
      if (weight > 100) consommation = 34;

      let autonomie = disponible / consommation;
      let allerRetour = distance * 2;

      let texte = "";
      texte += "Batterie totale : " + wh.toFixed(0) + " Wh<br>";
      texte += "Autonomie estimée : " + autonomie.toFixed(1) + " km<br>";
      texte += "Distance aller-retour : " + allerRetour.toFixed(1) + " km<br><br>";

      if (autonomie >= allerRetour) {
        texte += "Aller : OUI<br>";
        texte += "Aller-retour : OUI";
      } else if (autonomie >= distance) {
        texte += "Aller : OUI<br>";
        texte += "Aller-retour : NON";
      } else {
        texte += "Aller : NON<br>";
        texte += "Aller-retour : NON";
      }

      document.getElementById("result").innerHTML = texte;
    }
  </script>
</body>
</html>
